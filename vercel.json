{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/hot-digest/:step",
      "destination": "/api/hot?digest=:step"
    },
    {
      "source": "/api/billing/:action",
      "destination": "/api/billing?do=:action"
    },
    {
      "source": "/api/hot-score",
      "destination": "/api/hot?score=1"
    },
    {
      "source": "/api/health",
      "destination": "/api/config?health=1"
    }
  ],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/hot-digest/start",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/hot-digest/send",
      "schedule": "0 10 * * *"
    }
  ]
}